#!/usr/bin/env bash
# Pre-push hook:
# 1. Blocks non-interactive pushes (agent's bash tool has no TTY — can't bypass).
# 2. Blocks push unless every new commit has "Approved-by:" in body.
set -euo pipefail

REMOTE="$1"
URL="$2"

# Only enforce on the primary remote
if [ "$REMOTE" != "origin" ]; then
    exit 0
fi

# --- Interactive guard: block agent push (no TTY) ---
# The agent runs bash via a non-interactive tool with no TTY attached.
# Only a human at a real terminal can access /dev/tty.
# CI machines set CI=true (GitHub Actions, GitLab CI, etc.) and bypass this.
if [ -z "${CI:-}" ] && ! (exec < /dev/tty) 2>/dev/null; then
    echo ""
    echo "╔═══════════════════════════════════════════════════════════════════════════════════════╗"
    echo "║  PUSH BLOCKED — No terminal detected                                                  ║"
    echo "║                                                                                       ║"
    echo "║  The agent cannot push without human approval.                                        ║"
    echo "║  Run this command in your terminal:                                                   ║"
    echo "║                                                                                       ║"
    echo "║    git push origin $(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo '<branch>')" ║"
    echo "║                                                                                       ║"
    echo "║  Then type 'yes' when prompted.                                                       ║"
    echo "╚═══════════════════════════════════════════════════════════════════════════════════════╝"
    exit 1
fi

# --- Interactive confirmation: human at the terminal ---
if [ -z "${CI:-}" ]; then
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    echo ""
    echo "Push to origin/$CURRENT_BRANCH — type 'yes' to confirm:"
    CONFIRM=""
    read -r CONFIRM < /dev/tty
    if [ "$CONFIRM" != "yes" ]; then
        echo "Push cancelled."
        exit 1
    fi
fi

echo "✓ Push approved by human."

ZEROS="0000000000000000000000000000000000000000"
REJECTED=false

while read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
    # Deleting a ref — skip
    if [ "$LOCAL_SHA" = "$ZEROS" ]; then
        continue
    fi

    # New branch — check only commits not on origin/master (the new work)
    if [ "$REMOTE_SHA" = "$ZEROS" ]; then
        RANGE="origin/master..${LOCAL_SHA}"
    else
        RANGE="${REMOTE_SHA}..${LOCAL_SHA}"
    fi

    # Check every new commit for Approved-by:
    for COMMIT in $(git rev-list "$RANGE" 2>/dev/null); do
        APPROVED=$(git log -1 --format="%b" "$COMMIT" | grep -c "^Approved-by:" || true)
        if [ "$APPROVED" -eq 0 ]; then
            SHORT=$(git rev-parse --short "$COMMIT")
            echo ""
            echo "╔══════════════════════════════════════════════════════════════╗"
            echo "║  PUSH BLOCKED — Commit missing 'Approved-by:'               ║"
            echo "║                                                            ║"
            echo "║  Commit $SHORT lacks Approved-by: in body."
            echo "║  The agent likely bypassed the pre-commit guard.            ║"
            echo "║                                                            ║"
            echo "║  Fix: git commit --amend --no-edit                         ║"
            echo "║       (pre-commit hook auto-injects it when GIT_APPROVED    ║"
            echo "║        is set correctly)                                    ║"
            echo "╚══════════════════════════════════════════════════════════════╝"
            REJECTED=true
        fi
    done
done

if [ "$REJECTED" = true ]; then
    exit 1
fi
