#!/usr/bin/env bash
# Pre-commit hook:
# 1. Blocks non-interactive commits (agent's bash tool has no TTY — can't bypass).
# 2. Requires GIT_APPROVED=<message-id> to proceed.
set -euo pipefail

# --- Interactive guard: block agent commit (no TTY) ---
# The agent runs bash via a non-interactive tool with no TTY attached.
# Only a human at a real terminal can access /dev/tty.
# CI machines set CI=true (GitHub Actions, GitLab CI, etc.) and bypass this.
if [ -z "${CI:-}" ] && ! (exec < /dev/tty) 2>/dev/null; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  COMMIT BLOCKED — No terminal detected                       ║"
    echo "║                                                              ║"
    echo "║  The agent cannot commit without human approval.             ║"
    echo "║  Run this command in your terminal:                          ║"
    echo "║                                                              ║"
    echo "║  GIT_APPROVED='message-id' git commit -m '...'               ║"
    echo "║                                                              ║"
    echo "║  Then type 'yes' when prompted.                              ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    exit 1
fi

# --- Interactive confirmation: human at the terminal ---
if [ -z "${CI:-}" ]; then
    # /dev/tty is accessible — we are at a real terminal, ask for confirmation
    CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
    echo ""
    echo "Commit on $CURRENT_BRANCH — type 'yes' to confirm:"
    CONFIRM=""
    read -r CONFIRM < /dev/tty
    if [ "$CONFIRM" != "yes" ]; then
        echo "Commit cancelled."
        exit 1
    fi
fi

# Requires GIT_APPROVED=<message-id> to proceed.
# This prevents the agent from committing by setting a static ALLOW_COMMIT=1.
if [ -z "${GIT_APPROVED:-}" ]; then
    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║  COMMIT BLOCKED — No explicit user approval                 ║"
    echo "║                                                            ║"
    echo "║  The agent must set GIT_APPROVED=<message-id> to confirm   ║"
    echo "║  the user explicitly approved this commit. Example:         ║"
    echo "║    GIT_APPROVED='user said yes' git commit ...              ║"
    echo "║                                                            ║"
    echo "║  If you ARE the user and want to commit directly:           ║"
    echo "║    GIT_APPROVED=manual git commit ...                       ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
    echo ""
    exit 1
fi

echo "✓ Commit approved by human."

# Log approval for audit
echo "$(date -u +%Y-%m-%dT%H:%M:%SZ): commit with approval: $GIT_APPROVED" >> "$(git rev-parse --git-dir)/commit-approval.log"
